# ============================================================================
# 1. LLM & Speech-to-Text (100% Gratuit prin Groq Cloud sau Google Gemini)
# Obține cheia gratuită (fără card) de pe: https://console.groq.com/keys
# ============================================================================
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
STT_MODEL=whisper-large-v3-turbo

# Opțional: Google AI Studio Free Tier (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# ============================================================================
# 2. Text-to-Speech în Limba Română (100% Gratuit prin Microsoft Edge Neural)
# Opțiuni recomandate: ro-RO-AlinaNeural (Feminin) sau ro-RO-EmilNeural (Masculin)
# ============================================================================
DEFAULT_TTS_VOICE=ro-RO-AlinaNeural
DEFAULT_TTS_RATE=+5%

# ============================================================================
# 3. Sistemul de Programări Cal.com (Planul Free sincronizat cu Google Calendar)
# Dacă sunt lăsate goale, aplicația folosește automat calendarul intern de Demo!
# ============================================================================
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_TIMEZONE=Europe/Bucharest

# ============================================================================
# 4. Baza de Date Vectorială Qdrant Cloud (1 GB Free Tier permanent) & Supabase
# Dacă sunt lăsate goale, aplicația folosește memoria locală pre-populată.
# ============================================================================
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=clinic_knowledge

SUPABASE_URL=
SUPABASE_KEY=

# ============================================================================
# 5. Omnichannel Webhooks (WhatsApp Cloud API Meta / Telegram / Chatwoot)
# ============================================================================
WHATSAPP_VERIFY_TOKEN=receptioner_secret_token_2027
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

TELEGRAM_BOT_TOKEN=
CHATWOOT_API_URL=
CHATWOOT_API_TOKEN=

# Personalizare Brand Demo
CLINIC_NAME=Clinica Stomatologică Demo Smile
